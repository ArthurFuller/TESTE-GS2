{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "ef4e2a61d2474622a3c7a973b5a87f85",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Cartoon (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1400.0,
            "y": -900.0,
            "width": 260.0,
            "height": 200.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "a2ba2ac9c1a447d6a6e41cea46c735bc"
        },
        {
            "m_Id": "a74943758b194386967db03270112c0a"
        },
        {
            "m_Id": "3a6a8603e4054588a0aa3152b834936d"
        },
        {
            "m_Id": "345632ab1e6f46f9b99930172f7cbb9f"
        },
        {
            "m_Id": "9e0ce6cc2c454515a14f92fe87aecc78"
        },
        {
            "m_Id": "35d9c81ff5b84efdbb17ace27fb99a92"
        },
        {
            "m_Id": "a833ccc5aaf846d9a07b9bbada4314e6"
        },
        {
            "m_Id": "9c3e9c73dcec4d06a1a20b4efe467466"
        },
        {
            "m_Id": "127500f4f5e347d89956c96bab1bf18d"
        },
        {
            "m_Id": "2260cb5649ef4c839615769dcbb6d611"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Cartoon",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "\nfloat3 L = normalize(float3(-0.5, 0.7, -0.4));\nfloat atten = 1.0;\nfloat3 corLuz = float3(1, 1, 1);\n#if !defined(SHADERGRAPH_PREVIEW) && defined(UNIVERSAL_LIGHTING_INCLUDED)\n    Light luzP = GetMainLight(TransformWorldToShadowCoord(WorldPos));\n    L = luzP.direction;\n    atten = luzP.shadowAttenuation;\n    corLuz = luzP.color;\n#endif\nfloat3 N = normalize(Normal);\nfloat lum = saturate((dot(N, L) + 0.6) / 1.4);\nlum *= lerp(1.0, atten, ForcaSombraProjetada);\nfloat s = max(Suavidade, 0.001);\nfloat t = smoothstep(Limite - s, Limite + s, lum);\nfloat3 cor = lerp(CorBase * CorSombra, CorBase, t);\nfloat3 tinta = lerp(float3(1, 1, 1), saturate(corLuz), InfluenciaLuz);\nCor = cor * tinta;\nLuz = lum;\n"
}

