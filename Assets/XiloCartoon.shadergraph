{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "a9e299faccc444d3984c6b419fd19fe5",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Xilogravura (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1400.0,
            "y": -300.0,
            "width": 260.0,
            "height": 200.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "beea5e03b7114c10b592e6842585678d"
        },
        {
            "m_Id": "3d140d00235c49be870132f0229f6e54"
        },
        {
            "m_Id": "c0fcb358582647309d3365240b52956b"
        },
        {
            "m_Id": "118028692cda488498698b96dfe3b3f8"
        },
        {
            "m_Id": "5bb3e8966ead48d7a3d578c567a91cc9"
        },
        {
            "m_Id": "0dd66d46a38f44ccb231c4b140623e06"
        },
        {
            "m_Id": "1212b959b4c14b7f9ff06806731c01e2"
        },
        {
            "m_Id": "d168d077562b49c1a4661f0818776fa7"
        },
        {
            "m_Id": "3ad39aaa18d44259883ab9501f412e9c"
        },
        {
            "m_Id": "97c3396631b34e5696793f752824f3c0"
        },
        {
            "m_Id": "91910bc1de91461a81608747deea6ec8"
        },
        {
            "m_Id": "40fa621b2b1a437daa155363cc9280c5"
        },
        {
            "m_Id": "5bf308dc1aa647b782e170fd997c4f0f"
        },
        {
            "m_Id": "e05bb51c7fb7400e8029bd1f88ee8c87"
        },
        {
            "m_Id": "ce0f2dfc19d742299af21a78a0fe731d"
        },
        {
            "m_Id": "d1188f6281b44406b80f3c5f0e50495d"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Xilogravura",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "\nfloat3 p = lerp(WorldPos, ObjectPos, TracoNoObjeto);\nfloat3 n = abs(normalize(Normal));\n// plano dominante: chão/teto, parede X, parede Z\nfloat2 uv; float extra = 0.0;\nif (n.y >= n.x && n.y >= n.z) { uv = p.xz; extra = 0.785398; }\nelse if (n.x >= n.z)          { uv = p.zy; }\nelse                          { uv = p.xy; }\nfloat a = radians(Angulo) + extra;\nfloat sa = sin(a), ca = cos(a);\nfloat across = uv.y * ca + uv.x * sa;     // atravessa as linhas\nfloat along  = uv.x * ca - uv.y * sa;     // corre ao longo da linha\n\n// tremido da goiva (ruído suave feito com senos)\nfloat3 q = p * EscalaTremido;\nfloat ruido = sin(dot(q, float3(1.7, 2.3, 1.1)) * 1.9) * 0.6 + sin(dot(q, float3(-2.9, 1.3, 2.7)) * 2.7) * 0.4;\n// curvatura: linhas onduladas / redondas\nfloat onda = sin(along * (6.2831 / max(TamanhoCurva, 0.01))) * Curvatura;\n\nfloat x = across * LinhasPorMetro + ruido * Tremido + onda;\nfloat idx = floor(x);\nfloat f = frac(x);\nfloat perfil = abs(f * 2.0 - 1.0);                // 1 = meio da linha, 0 = entre linhas\nfloat aa = max(fwidth(x) * 2.0, 0.0001);\n\n// falhas: pedaços da linha que somem (como goiva que pulou)\nfloat h = frac(sin(idx * 91.3458) * 47453.5453);\nfloat g = sin(along * LinhasPorMetro * 0.35 + h * 6.2831 + ruido);\nfloat falha = step(1.0 - Falhas * 2.0, g) * step(0.001, Falhas);\n\n// traço escuro: mais grosso na sombra, afina na luz\nfloat escuro = saturate((1.0 - Luz) * Quantidade * 2.0);\nfloat largura = Espessura * escuro * (0.85 + 0.3 * h);\nSombra = smoothstep(1.0 - largura - aa, 1.0 - largura + aa, perfil) * (1.0 - falha) * step(0.001, largura);\n\n// traço claro (entalhe na luz), intercalado\nfloat perfil2 = abs(frac(x + 0.5) * 2.0 - 1.0);\nfloat claro = saturate((Luz - 0.55) * 2.2);\nfloat largura2 = Espessura * 0.7 * claro;\nBrilho = smoothstep(1.0 - largura2 - aa, 1.0 - largura2 + aa, perfil2) * (1.0 - falha) * step(0.001, largura2);\n"
}

