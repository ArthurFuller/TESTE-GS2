        {
            "m_Id": "e122d8d784e647b587bd42e9b71ea5ef"
        },
        {
            "m_Id": "e8bd6a9b87eb42e9945aae5a3c66a9f7"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Juntar",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "\nfloat3 c = CorCartoon;\nc = lerp(c, CorTraco, saturate(Sombra * IntensidadeTraco));\nc = lerp(c, CorTracoLuz, saturate(Brilho * IntensidadeTracoLuz));\nc = lerp(c, CorLineArt, saturate(Linha * IntensidadeLineArt));\nCor = c;\n"
}

